-- Signature & avoidance checks for outRects against R10.P .N = (X05 × X05) ∪ (X15 × X15)
def sig5Bool (w : StrongPowV (ZMod 7) 5) : Nat :=
  (if tX05.inClosedNbr w then 2 else 0) + (if tX15.inClosedNbr w then 1 else 0)

def sig5_3Bool (w : StrongPowV (ZMod 7) 5) : Nat :=
  (if tX05.inClosedNbr w then 4 else 0) + (if tXH5.inClosedNbr w then 2 else 0) + (if tXV5.inClosedNbr w then 1 else 0)

def outRectPairAvoids (a b : Nat) : Bool :=
  (!trieAny (fun w => tX05.inClosedNbr w) (rectAt a) || !trieAny (fun w => tX05.inClosedNbr w) (rectAt b)) &&
  (!trieAny (fun w => tX15.inClosedNbr w) (rectAt a) || !trieAny (fun w => tX15.inClosedNbr w) (rectAt b))

theorem outRects_avoid_R10N : outRects.all (fun (a, b) => outRectPairAvoids a b) = true := by decide

-- Block containment and swap checks
def jBlockL (b : Nat) : Trie7 5 := match b with
  | 0 => tTB5 | 1 => tTS5 | 2 => tTPH5 | 3 => tTPV5 | 4 => tTX05 | 5 => tTXH5 | _ => tTXV5

def jBlockR (b : Nat) : Trie7 5 := match b with
  | 0 => tTB5 | 1 => tTX05 | 2 => tTXH5 | 3 => tTXV5 | 4 => tTS5 | 5 => tTPV5 | _ => tTPH5

theorem outBlocks_sub : outBlocks.all (fun (b, (ia, ib)) =>
  (rectAt ia).isSubset (jBlockL b) && (rectAt ib).isSubset (jBlockR b)) = true := by decide

theorem inBlocks_sub : inBlocks.all (fun (b, (ia, ib)) =>
  (rectAt ia).isSubset (jBlockL b) && (rectAt ib).isSubset (jBlockR b)) = true := by decide

theorem remBlocks_mem : remBlocks.all (fun (b, (r0, r1)) =>
  (jBlockL b).memBool r0 && (jBlockR b).memBool r1) = true := by decide

theorem rems_disj_outBase : remBlocks.all (fun (_, (r0, r1)) =>
  outRectsBase.all (fun (ia, ib) => !((rectAt ia).memBool r0 && (rectAt ib).memBool r1))) = true := by decide

theorem rems_disj_in : remBlocks.all (fun (_, (r0, r1)) =>
  inRects.all (fun (ia, ib) => !((rectAt ia).memBool r0 && (rectAt ib).memBool r1))) = true := by decide

theorem rems_nodup : (swapPairs.map Prod.fst).Nodup := by decide
theorem inss_nodup : (swapPairs.map Prod.snd).Nodup := by decide


def checkInsMatch : List (StrongPowV (ZMod 7) 5 × StrongPowV (ZMod 7) 5) → List (Nat × Nat) → Bool
  | [], [] => true
  | (v0, v1) :: vs, (ia, ib) :: rs =>
    ((rectAt ia).card == 1) && ((rectAt ib).card == 1) &&
    (rectAt ia).memBool v0 && (rectAt ib).memBool v1 && checkInsMatch vs rs
  | _, _ => false

theorem swapIns_match : checkInsMatch (swapPairs.map Prod.snd) (outRects.drop 8) = true := by decide

-- Check pairwise non-adjacency of swapInss and unique hit of each swapIns in J10_base:
def word5AdjOrEq (u v : StrongPowV (ZMod 7) 5) : Bool :=
  (u.1 == v.1 || (u.1 - v.1 == 1) || (v.1 - u.1 == 1)) &&
  (u.2.1 == v.2.1 || (u.2.1 - v.2.1 == 1) || (v.2.1 - u.2.1 == 1)) &&
  (u.2.2.1 == v.2.2.1 || (u.2.2.1 - v.2.2.1 == 1) || (v.2.2.1 - u.2.2.1 == 1)) &&
  (u.2.2.2.1 == v.2.2.2.1 || (u.2.2.2.1 - v.2.2.2.1 == 1) || (v.2.2.2.1 - u.2.2.2.1 == 1)) &&
  (u.2.2.2.2.1 == v.2.2.2.2.1 || (u.2.2.2.2.1 - v.2.2.2.2.1 == 1) || (v.2.2.2.2.1 - u.2.2.2.2.1 == 1))

def listPairwiseNotClose10 : List (StrongPowV (ZMod 7) 5 × StrongPowV (ZMod 7) 5) → Bool
  | [] => true
  | (u0, u1) :: rest =>
    rest.all (fun (v0, v1) => !(word5AdjOrEq u0 v0 && word5AdjOrEq u1 v1)) && listPairwiseNotClose10 rest

theorem inss_indep_ok : listPairwiseNotClose10 (swapPairs.map Prod.snd) = true := by decide

def blockHitsOnly (b : Nat) (v0 v1 r0 r1 : StrongPowV (ZMod 7) 5) : Bool :=
  trieAll (fun u0 =>
    !word5AdjOrEq v0 u0 ||
    trieAll (fun u1 => !word5AdjOrEq v1 u1 || (u0 == r0 && u1 == r1)) (jBlockR b)) (jBlockL b)

def swapHitOK (p : (StrongPowV (ZMod 7) 5 × StrongPowV (ZMod 7) 5) × (StrongPowV (ZMod 7) 5 × StrongPowV (ZMod 7) 5)) : Bool :=
  [0, 1, 2, 3, 4, 5, 6].all (fun b => blockHitsOnly b p.2.1 p.2.2 p.1.1 p.1.2)

theorem swap_hit_0 : swapHitOK swapPairs[0] = true := by decide
theorem swap_hit_1 : swapHitOK swapPairs[1] = true := by decide
theorem swap_hit_2 : swapHitOK swapPairs[2] = true := by decide
theorem swap_hit_3 : swapHitOK swapPairs[3] = true := by decide
theorem swap_hit_4 : swapHitOK swapPairs[4] = true := by decide
theorem swap_hit_5 : swapHitOK swapPairs[5] = true := by decide
theorem swap_hit_6 : swapHitOK swapPairs[6] = true := by decide
