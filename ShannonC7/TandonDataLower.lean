    trieAll (fun r => f (0, r)) c0 && trieAll (fun r => f (1, r)) c1 &&
    trieAll (fun r => f (2, r)) c2 && trieAll (fun r => f (3, r)) c3 &&
    trieAll (fun r => f (4, r)) c4 && trieAll (fun r => f (5, r)) c5 &&
    trieAll (fun r => f (6, r)) c6

def trieAny (f : StrongPowV (ZMod 7) 5 → Bool) (t : Trie7 5) : Bool :=
  !(trieAll (fun w => !f w) t)

