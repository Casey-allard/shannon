theorem base_out_in_sum :
  (outRectsBase.map (fun (a, b) => (rectAt a).card * (rectAt b).card)).sum +
  (inRects.map (fun (a, b) => (rectAt a).card * (rectAt b).card)).sum + 8 = 134753 := by decide


def maskOf (w : StrongPowV (ZMod 7) 5) : Nat :=
  rectTries.foldl (fun acc (i, t) => if t.inClosedNbr w then acc ||| (1 <<< i) else acc) 0

def keyOf (w : StrongPowV (ZMod 7) 5) : Nat :=
  (sig5Bool w) + 4 * maskOf w

def addHistCount (k cnt : Nat) : List (Nat × Nat) → List (Nat × Nat)
  | [] => [(k, cnt)]
  | (k', c) :: rest => if k == k' then (k', c + cnt) :: rest else (k', c) :: addHistCount k cnt rest

def mergeHist (h1 h2 : List (Nat × Nat)) : List (Nat × Nat) :=
  h1.foldl (fun acc (k, cnt) => addHistCount k cnt acc) h2

def histTrieAux : {d : ℕ} → (StrongPowV (ZMod 7) d → Nat) → Trie7 d → List (Nat × Nat)
  | _, _, .empty => []
  | 0, f, .leaf => [(f PUnit.unit, 1)]
  | _ + 1, f, .node c0 c1 c2 c3 c4 c5 c6 =>
    let h0 := histTrieAux (fun r => f (0, r)) c0
    let h1 := histTrieAux (fun r => f (1, r)) c1
    let h2 := histTrieAux (fun r => f (2, r)) c2
    let h3 := histTrieAux (fun r => f (3, r)) c3
    let h4 := histTrieAux (fun r => f (4, r)) c4
    let h5 := histTrieAux (fun r => f (5, r)) c5
    let h6 := histTrieAux (fun r => f (6, r)) c6
    mergeHist h0 (mergeHist h1 (mergeHist h2 (mergeHist h3 (mergeHist h4 (mergeHist h5 h6)))))

def histOf (t : Trie7 5) : List (Nat × Nat) := histTrieAux keyOf t

def reqMask (rects : List (Nat × Nat)) (m0 : Nat) : Nat :=
  rects.foldl (fun acc (ia, ib) => if (m0 >>> ia) &&& 1 == 1 then acc ||| (1 <<< ib) else acc) 0

structure Vec16 where
  v0 : Nat := 0
  v1 : Nat := 0
  v2 : Nat := 0
  v3 : Nat := 0
  v4 : Nat := 0
  v5 : Nat := 0
  v6 : Nat := 0
  v7 : Nat := 0
  v8 : Nat := 0
  v9 : Nat := 0
  v10 : Nat := 0
  v11 : Nat := 0
  v12 : Nat := 0
  v13 : Nat := 0
  v14 : Nat := 0
  v15 : Nat := 0
  deriving BEq, DecidableEq

def Vec16.addAt (x : Vec16) (i val : Nat) : Vec16 :=
  match i with
  | 0 => { x with v0 := x.v0 + val } | 1 => { x with v1 := x.v1 + val }
  | 2 => { x with v2 := x.v2 + val } | 3 => { x with v3 := x.v3 + val }
  | 4 => { x with v4 := x.v4 + val } | 5 => { x with v5 := x.v5 + val }
  | 6 => { x with v6 := x.v6 + val } | 7 => { x with v7 := x.v7 + val }
  | 8 => { x with v8 := x.v8 + val } | 9 => { x with v9 := x.v9 + val }
  | 10 => { x with v10 := x.v10 + val } | 11 => { x with v11 := x.v11 + val }
  | 12 => { x with v12 := x.v12 + val } | 13 => { x with v13 := x.v13 + val }
  | 14 => { x with v14 := x.v14 + val } | _ => { x with v15 := x.v15 + val }

def Vec16.get (x : Vec16) (i : Nat) : Nat :=
  match i with
  | 0 => x.v0 | 1 => x.v1 | 2 => x.v2 | 3 => x.v3
  | 4 => x.v4 | 5 => x.v5 | 6 => x.v6 | 7 => x.v7
  | 8 => x.v8 | 9 => x.v9 | 10 => x.v10 | 11 => x.v11
  | 12 => x.v12 | 13 => x.v13 | 14 => x.v14 | _ => x.v15

def Vec16.add (a b : Vec16) : Vec16 :=
  ⟨a.v0+b.v0, a.v1+b.v1, a.v2+b.v2, a.v3+b.v3, a.v4+b.v4, a.v5+b.v5, a.v6+b.v6, a.v7+b.v7,
   a.v8+b.v8, a.v9+b.v9, a.v10+b.v10, a.v11+b.v11, a.v12+b.v12, a.v13+b.v13, a.v14+b.v14, a.v15+b.v15⟩

def dist10_16_row (kA cA : Nat) (hB : List (Nat × Nat)) : Vec16 :=
  let sA := kA % 4; let mA := kA / 4
  let a0 := (sA >>> 1) &&& 1; let a1 := sA &&& 1
  let ro := reqMask outRects mA; let ri := reqMask inRects mA
  let rec go : List (Nat × Nat) → Vec16 → Vec16
    | [], acc => acc
    | (kB, cB) :: rest, acc =>
      let sB := kB % 4; let mB := kB / 4
      let b0 := (sB >>> 1) &&& 1; let b1 := sB &&& 1
      let inX0 := (a0 &&& b0) ||| (a1 &&& b1)
      let inX1 := (a0 &&& b1) ||| (a1 &&& b0)
      let inJo := if (mB &&& ro) != 0 then 1 else 0
      let inJi := if (mB &&& ri) != 0 then 1 else 0
      let idx := (inX0 <<< 3) ||| (inX1 <<< 2) ||| (inJo <<< 1) ||| inJi
      go rest (Vec16.addAt acc idx (cA * cB))
  go hB ({} : Vec16)

def dist10_16_hist (hA hB : List (Nat × Nat)) : Vec16 :=
  let rec go : List (Nat × Nat) → Vec16 → Vec16
    | [], acc => acc
    | (kA, cA) :: rest, acc => go rest (acc.add (dist10_16_row kA cA hB))
  go hA ({} : Vec16)

def dist5_3Trie : {d : ℕ} → (StrongPowV (ZMod 7) d → Nat) → Trie7 d → Vec16
  | _, _, .empty => {}
  | 0, f, .leaf => Vec16.addAt {} (f PUnit.unit) 1
  | _ + 1, f, .node c0 c1 c2 c3 c4 c5 c6 =>
    let d0 := dist5_3Trie (fun r => f (0, r)) c0
    let d1 := dist5_3Trie (fun r => f (1, r)) c1
    let d2 := dist5_3Trie (fun r => f (2, r)) c2
    let d3 := dist5_3Trie (fun r => f (3, r)) c3
    let d4 := dist5_3Trie (fun r => f (4, r)) c4
    let d5 := dist5_3Trie (fun r => f (5, r)) c5
    let d6 := dist5_3Trie (fun r => f (6, r)) c6
    d0.add (d1.add (d2.add (d3.add (d4.add (d5.add d6)))))

def dist5_3List (t : Trie7 5) : Vec16 := dist5_3Trie sig5_3Bool t

def lift15 (d16 d5t : Vec16) : Vec16 :=
  (List.finRange 16).foldl (fun acc s10 =>
    let v10 := Vec16.get d16 s10.val
    if v10 == 0 then acc else
    let x0 := (s10.val >>> 3) &&& 1; let x1 := (s10.val >>> 2) &&& 1
    let jo := (s10.val >>> 1) &&& 1; let ji := s10.val &&& 1
    (List.finRange 8).foldl (fun acc2 s5 =>
      let v5 := Vec16.get d5t s5.val
      if v5 == 0 then acc2 else
      let w0 := (s5.val >>> 2) &&& 1; let wh := (s5.val >>> 1) &&& 1; let wv := s5.val &&& 1
      let w1 := wh ||| wv
      let u0 := (x0 &&& w0) ||| (x1 &&& w1); let u1 := (x0 &&& w1) ||| (x1 &&& w0)
      let v0 := (x0 &&& w0) ||| (jo &&& wh) ||| (x1 &&& wv)
      let v1 := (x1 &&& w0) ||| (x0 &&& wv) ||| (ji &&& wh)
      let idx := (u0 <<< 3) ||| (u1 <<< 2) ||| (v0 <<< 1) ||| v1
      Vec16.addAt acc2 idx (v10 * v5)
    ) acc
  ) ({} : Vec16)

def countAvoid15 (d16 d5t : Vec16) : Nat :=
  (List.finRange 16).foldl (fun acc s10 =>
    let v10 := Vec16.get d16 s10.val
    let x0 := (s10.val >>> 3) &&& 1; let x1 := (s10.val >>> 2) &&& 1
    (List.finRange 8).foldl (fun acc2 s5 =>
      let v5 := Vec16.get d5t s5.val
      let w0 := (s5.val >>> 2) &&& 1; let w1 := ((s5.val >>> 1) ||| s5.val) &&& 1
      if ((x0 &&& w0) ||| (x1 &&& w1)) == 0 then acc2 + v10 * v5 else acc2
    ) acc
  ) 0

def countAvoid30 (dL dR : Vec16) : Nat :=
  let L4 := (List.finRange 16).foldl (fun acc s => Vec16.addAt acc ((s.val >>> 2) &&& 3) (Vec16.get dL s.val)) ({} : Vec16)
  let R4 := (List.finRange 16).foldl (fun acc s => Vec16.addAt acc (s.val &&& 3) (Vec16.get dR s.val)) ({} : Vec16)
  (List.finRange 4).foldl (fun acc u =>
    (List.finRange 4).foldl (fun acc2 v =>
      let u0 := (u.val >>> 1) &&& 1; let u1 := u.val &&& 1
      let v0 := (v.val >>> 1) &&& 1; let v1 := v.val &&& 1
      if ((u0 &&& v0) ||| (u1 &&& v1)) == 0 then acc2 + (Vec16.get L4 u.val) * (Vec16.get R4 v.val) else acc2
    ) acc
  ) 0

