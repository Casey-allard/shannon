def rectsDisj1 (a1 b1 a2 b2 : Nat) : Bool :=
  (rectAt a1).disjoint (rectAt a2) || (rectAt b1).disjoint (rectAt b2)

def rectListPairwiseDisj : List (Nat × Nat) → Bool
  | [] => true
